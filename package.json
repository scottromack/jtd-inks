{
  "name": "just-the-docs",
  "version": "0.3.3",
  "description": "A modern Jekyll theme for documentation",
  "repository": "just-the-docs/just-the-docs",
  "license": "MIT",
  "bugs": "https://github.com/just-the-docs/just-the-docs/issues",
  "devDependencies": {
    "@mus/inks": "file:../inks",
    "@tailwindcss/cli": "^4.3.2",
    "@tailwindcss/typography": "^0.5.16",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.2"
  },
  "scripts": {
    "lint": "npm-run-all --parallel --continue-on-error lint:*",
    "lint:formatting": "prettier --check '**/*.{js,json}'",
    "format": "prettier --write '**/*.{js,json}'",
    "test": "npm run lint",
    "css": "tailwindcss -i _tailwind/app.css -o assets/css/app.css",
    "css:watch": "tailwindcss -i _tailwind/app.css -o assets/css/app.css --watch",
    "serve": "bundle exec jekyll serve",
    "dev": "npm-run-all --parallel css:watch serve",
    "grace-words": "node tools/grace-words.mjs ../grace-commons/GRACE-lang.md"
  },
  "prettier": {
    "endOfLine": "lf",
    "semi": false,
    "singleQuote": false,
    "tabWidth": 2,
    "trailingComma": "es5"
  }
}
